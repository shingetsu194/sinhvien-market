# Copy file này thành .env và điền thông tin thực tế
# KHÔNG commit file .env lên Git!

APP_NAME=SinhVienMarket
APP_URL=http://localhost:8080/sinhvien-market
# Base URL of the Next.js frontend that legacy PHP page routes redirect to.
# Leave empty only when a reverse proxy serves Next.js pages on the same host;
# otherwise PHP would redirect /login to itself (it now answers 503 instead).
NEXT_APP_URL=http://localhost:3000
APP_ENV=development
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sinhvien_market
DB_USER=root
DB_PASS=

# Huy hiệu "Sinh viên đã xác thực": mọi tên miền con của edu.vn, ac.vn, edu
# đều được chấp nhận. Khai báo thêm tên miền trường KHÔNG theo đuôi đó,
# cách nhau bằng dấu phẩy (tên miền con cũng được chấp nhận), vd: udn.vn
STUDENT_EMAIL_DOMAINS=

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password

# Google OAuth. PHP must verify HTTPS: on Windows set curl.cainfo and
# openssl.cafile in php.ini to a CA bundle (e.g. Git's ca-bundle.crt), or
# login fails at the token step (logged as "cURL 60").
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/sinhvien-market/auth/google/callback

GEMINI_API_KEY=your_gemini_api_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ZaloPay Sandbox
ZALOPAY_APP_ID=2553
ZALOPAY_KEY1=PcY4iZIKFCIdgZvA6ueMcMHHUbRLYjPL
